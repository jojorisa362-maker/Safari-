[Unit]
Description=Safari Rescue
After=network.target

[Service]
Type=simple
User=safari
WorkingDirectory=/opt/safari-rescue
EnvironmentFile=/etc/safari-rescue.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/safari-rescue/data

[Install]
WantedBy=multi-user.target
