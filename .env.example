# Copy to .env (Docker / local) or add these in your host's "Environment" screen.

# --- required in production ---
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-string     # keeps logins valid across restarts

# --- storage ---
# Leave DATABASE_URL empty to use a JSON file in DATA_DIR (fine on a VPS).
# On Render free / Heroku / Railway the disk is wiped on restart, so set a Postgres URL:
DATABASE_URL=postgresql://safari_lmp8_user:m5nDiWV04aRS2XjXBbPQyWuGwdD0fm11@dpg-db19hp60tbcc73a5sl80-a.virginia-postgres.render.com/safari_lmp8
# PGSSL=disable                                      # only for a local Postgres without SSL (e.g. docker compose)
# DATA_DIR=./data

# --- behaviour ---
DEMO_MODE=1                    # 1 = "Try the demo" buttons + a virtual rescuer. Set 0 for real customers.
# PROVIDER_APPROVAL=manual     # auto|manual  (default: auto while DEMO_MODE=1, manual after)
ADMIN_TOKEN=                   # password for /admin (approve rescuers, watch live SOS). Empty = admin off.
SUPPORT_PHONE=+256 700 000 999
EMERGENCY_NUMBERS=999,112      # shown on the SOS screen

# --- alerts (optional) ---
# Every SOS / request / booking is POSTed here as JSON (e.g. to your WhatsApp bot).
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=         # if set, requests carry X-Signature: sha256=<hmac of body>

# --- docker compose with the local Postgres profile ---
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://safari:change-me@db:5432/safari
# PGSSL=disable
